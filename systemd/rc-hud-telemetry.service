[Unit]
Description=RC PTZ HUD - telemetry UART-to-websocket bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rc-ptz-with-hud/telemetry
# Uses whatever python/venv the deploy sets up; adjust the interpreter path
# to a venv with telemetry/requirements.txt installed.
ExecStart=/opt/rc-ptz-with-hud/telemetry/.venv/bin/python server.py --port /dev/serial0 --baud 115200
Restart=on-failure

[Install]
WantedBy=multi-user.target
