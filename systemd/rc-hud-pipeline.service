[Unit]
Description=RC PTZ HUD - camera capture/encode pipeline
After=network.target rc-hud-mediamtx.service
Requires=rc-hud-mediamtx.service

[Service]
Type=simple
User=admincam
WorkingDirectory=/home/admincam/RC-ptz-with-hud
# CAM=0 is this Pi's ov5647 camera index (confirmed via `rpicam-hello
# --list-cameras`). single_cam_stream.sh for the current one-camera bench
# test; switch to pip_stream.sh once a second camera is added.
Environment=CAM=0
ExecStart=/home/admincam/RC-ptz-with-hud/pipeline/single_cam_stream.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
