[Unit]
Description=RC PTZ HUD - camera capture/encode pipeline
After=network.target rc-hud-mediamtx.service
Requires=rc-hud-mediamtx.service

[Service]
Type=simple
User=admincam
WorkingDirectory=/home/admincam/RC-ptz-with-hud
# MAIN_CAM=0 / INSET_CAM=1 confirmed via `rpicam-hello --list-cameras` --
# re-check if a camera is ever added/removed/reseated, indices can change.
# pip_stream.sh writes its own PID to /tmp/rc-hud-pip-stream.pid so the web
# app's POST /api/pip/swap endpoint can signal it to swap camera roles live.
Environment=MAIN_CAM=0
Environment=INSET_CAM=1
ExecStart=/home/admincam/RC-ptz-with-hud/pipeline/pip_stream.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
